# Copy to .env and replace every value. Never commit .env.
# Leave a key blank to disable that feature. With no Telegram keys, the
# daily digest prints in the terminal.

# One token per butler (春 scout / 夏 score / 秋 act). Any blank butler
# falls back to TELEGRAM_BOT_TOKEN. Create tokens with @BotFather.
TELEGRAM_TOKEN_SPRING=replace-me
TELEGRAM_TOKEN_SUMMER=replace-me
TELEGRAM_TOKEN_AUTUMN=replace-me

# Single-bot fallback used by every butler that has no token of its own.
TELEGRAM_BOT_TOKEN=replace-me

# Numeric chat id from getUpdates. Group ids are negative.
TELEGRAM_CHAT_ID=replace-me

# Set to 1 only on a machine that should commit notes/ and push.
# Leave unset in CI and on any shared machine.
MONEY_BOT_PUBLISH=

# Optional semi-automated form fill. Point this at a COPY of a Chrome
# profile, never at a live ~/.config/google-chrome directory.
MONEY_BOT_PROFILE_DIR=
# Set to 1 for a visible browser while debugging.
MONEY_BOT_HEADED=

# Optional read-only Gmail check for verification mail.
# Use a Google app password, never the account password.
GMAIL_ADDRESS=bot@example.com
GMAIL_APP_PASSWORD=replace-me

# Local profile used only to draft participation packs on this machine.
# Public contact fields only. Never put a password, seed phrase,
# recovery phrase, or private key in any of these.
PROFILE_NAME=Ada Example
PROFILE_EMAIL=ada@example.com
PROFILE_PHONE=+10000000000
PROFILE_ADDRESS=1 Example Street
PROFILE_WALLET_EVM=0x0000000000000000000000000000000000000000
PROFILE_TWITTER=@example
PROFILE_TELEGRAM=@example
